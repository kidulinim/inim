Subject: [PATCH 1/9] F-1: key ring by blinded ident (SHA256(stA || A)), safe
 copies, zeroize stack buffers

---
 libi2pd/Blinding.cpp    | 13 ++++++++++++
 libi2pd/Blinding.h      |  1 +
 libi2pd/Destination.cpp | 47 ++++++++++++++++++++++++++++++++++++++++-
 libi2pd/Destination.h   |  5 +++++
 4 files changed, 65 insertions(+), 1 deletion(-)

diff --git a/libi2pd/Blinding.cpp b/libi2pd/Blinding.cpp
index 2006462..778a9df 100644
--- a/libi2pd/Blinding.cpp
+++ b/libi2pd/Blinding.cpp
@@ -334,6 +334,19 @@ namespace data
 			LogPrint (eLogError, "Blinding: Blinded key type ", (int)m_BlindedSigType, " is not supported");
 		return hash;
 	}
+	i2p::data::IdentHash BlindedPublicKey::GetIdentHash () const // INIM fork F-1
+	{
+		// stable blinded identity = SHA256(stA || A) — what a b33 address carries; not the daily store hash
+		i2p::data::IdentHash hash;
+		auto stA = htobe16 (m_SigType);
+		EVP_MD_CTX * ctx = EVP_MD_CTX_new ();
+		EVP_DigestInit_ex (ctx, EVP_sha256 (), NULL);
+		EVP_DigestUpdate (ctx, (const uint8_t *)&stA, 2);
+		EVP_DigestUpdate (ctx, m_PublicKey.data (), m_PublicKey.size ());
+		EVP_DigestFinal_ex (ctx, (uint8_t *)hash, nullptr);
+		EVP_MD_CTX_free (ctx);
+		return hash;
+	}
 
 }
 }
