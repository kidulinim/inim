@@ -497,9 +497,14 @@ namespace client
 					m_LeaseSetRequests.erase (it2);
 					if (request->requestedBlindedKey)
 					{
+						i2p::data::Tag<32> lsKey;
+						bool haveKeyRingKey = GetKeyRingKey (request->requestedBlindedKey->GetIdentHash (), lsKey);
+						const uint8_t * privKey = haveKeyRingKey ? (const uint8_t *)lsKey :
+							(m_LeaseSetPrivKey ? ((const uint8_t *)*m_LeaseSetPrivKey) : nullptr);
 						auto ls2 = std::make_shared<i2p::data::LeaseSet2> (buf + offset, len - offset,
 							request->requestedBlindedKey, shared_from_this (),
-						    m_LeaseSetPrivKey ? ((const uint8_t *)*m_LeaseSetPrivKey) : nullptr, GetPreferredCryptoType ());
+							privKey, GetPreferredCryptoType ());
+						lsKey.Fill (0); // INIM fork F-1: don't leave the key copy on the stack
 						if (ls2->IsValid () && !ls2->IsExpired ())
 						{
 							leaseSet = ls2;
@@ -1604,6 +1609,46 @@ namespace client
 		return nullptr;
 	}
 
+	bool LeaseSetDestination::GetKeyRingKey (const i2p::data::IdentHash& blindedIdent, i2p::data::Tag<32> & k) const // INIM fork F-1
+	{
+		std::lock_guard<std::mutex> lock (m_KeyRingMutex);
+		auto it = m_KeyRing.find (blindedIdent);
+		if (it != m_KeyRing.end ())
+		{
+			k = it->second;
+			return true;
+		}
+		return false;
+	}
+
+	void LeaseSetDestination::SetKeyRingKey (const i2p::data::IdentHash& blindedIdent, std::string keyBase64)
+	{
+		i2p::data::Tag<32> key;
+		if (key.FromBase64 (keyBase64) != 32)
+		{
+			LogPrint (eLogError, "Destination: Invalid key ring key for ", blindedIdent.ToBase64 ());
+			return;
+		}
+		// INIM fork F-1: scrub our base64 copy (keyBase64 is taken by value for this purpose)
+		std::fill (keyBase64.begin (), keyBase64.end (), '\0');
+		std::lock_guard<std::mutex> lock (m_KeyRingMutex);
+		m_KeyRing[blindedIdent] = key;
+		key.Fill (0); // INIM fork F-1: don't leave the key copy on the stack
+		LogPrint (eLogInfo, "Destination: Key ring entry set for ", blindedIdent.ToBase64 ());
+	}
+
+	void LeaseSetDestination::RemoveKeyRingKey (const i2p::data::IdentHash& blindedIdent)
+	{
+		std::lock_guard<std::mutex> lock (m_KeyRingMutex);
+		auto it = m_KeyRing.find (blindedIdent);
+		if (it != m_KeyRing.end ())
+		{
+			it->second.Fill (0); // zeroize secret before erase
+			m_KeyRing.erase (it);
+			LogPrint (eLogInfo, "Destination: Key ring entry removed for ", blindedIdent.ToBase64 ());
+		}
+	}
+
 	void ClientDestination::ReadAuthKey (const std::string& group, const i2p::util::Mapping * params)
 	{
 		for (const auto& it: params->GetOptions ())
