--- /dev/null
+++ b/tests/test-keyring-revocation.cpp
@@ -0,0 +1,65 @@
+// INIM fork: key-ring revocation unit test (F-1, Reviewer 1 round 4 items 1 and 6).
+// Covers:
+//  1) SetKeyRingKey / GetKeyRingKey / RemoveKeyRingKey round trip (guards the
+//     SetKeyRingKey definition that went missing in patch 0004).
+//  2) RemoveKeyRingKey terminates the peer's ECIES session AND drops its
+//     session tags from m_ECIESx25519Tags, so a revoked peer cannot keep
+//     delivering on stale tags (spec 7.9 / F-4 semantics for F-1).
+#include <cassert>
+#include <cstring>
+#include <iostream>
+#include <memory>
+#include "Destination.h"
+#include "ECIESX25519AEADRatchetSession.h"
+#include "Identity.h"
+
+// Minimal ClientDestination for key-ring unit checks (not Start()ed: F-1's
+// SetKeyRingKey/GetKeyRingKey don't depend on tunnels or netdb).
+int main ()
+{
+	boost::asio::io_context service;
+	auto keys = i2p::data::PrivateKeys::CreateRandomKeys (i2p::data::SIGNING_KEY_TYPE_EDDSA_SHA512_ED25519,
+		i2p::data::CRYPTO_KEY_TYPE_ECIES_X25519_AEAD);
+	auto dest = std::make_shared<i2p::client::ClientDestination> (service, keys, false, nullptr);
+
+	// 1) SetKeyRingKey / GetKeyRingKey / RemoveKeyRingKey (round 4 item 1: the
+	//    definition vanished in 0004 -- a test catches it if it goes missing again).
+	uint8_t raw[32];
+	for (int i = 0; i < 32; i++) raw[i] = (uint8_t)i;
+	i2p::data::Tag<32> blinded; blinded.Randomize ();
+	std::string key64 = i2p::data::ByteStreamToBase64 (raw, 32);
+	dest->SetKeyRingKey (blinded, key64);
+	i2p::data::Tag<32> got;
+	assert (dest->GetKeyRingKey (blinded, got));
+	assert (!memcmp (got, raw, 32));
+
+	// scrub even on decode failure: a bogus key must not be registered
+	i2p::data::Tag<32> blinded2; blinded2.Randomize ();
+	dest->SetKeyRingKey (blinded2, "!!!not-base64!!!");
+	assert (!dest->GetKeyRingKey (blinded2, got));
+
+	// 2) revocation terminates sessions and drops their tags (round 4 item 6)
+	auto session = std::make_shared<i2p::garlic::ECIESX25519AEADRatchetSession> (dest.get (), false);
+	uint8_t staticKey[32];
+	for (int i = 0; i < 32; i++) staticKey[i] = (uint8_t)(0x40 + i);
+	dest->AddECIESx25519Session (staticKey, session);
+
+	auto tagset = std::make_shared<i2p::garlic::ReceiveRatchetTagSet> (session);
+	uint8_t rootKey[32], chainKey[32];
+	memset (rootKey, 1, 32); memset (chainKey, 7, 32);
+	tagset->DHInitialize (rootKey, chainKey);
+	tagset->SetTagSetID (1);
+	uint64_t tag = dest->AddECIESx25519SessionNextTag (tagset);
+	assert (tag != 0);
+	assert (dest->GetNumIncomingECIESx25519Tags () == 1);
+
+	dest->SetKeyRingSessionKeys (blinded, {i2p::data::Tag<32> (staticKey)});
+	dest->RemoveKeyRingKey (blinded);
+
+	assert (!dest->GetKeyRingKey (blinded, got));                   // ring entry gone
+	assert (dest->GetNumIncomingECIESx25519Tags () == 0);           // session tags dropped
+	assert (session->IsTerminated ());                              // session terminated
+
+	std::cout << "test-keyring-revocation: all checks passed" << std::endl;
+	return 0;
+}
