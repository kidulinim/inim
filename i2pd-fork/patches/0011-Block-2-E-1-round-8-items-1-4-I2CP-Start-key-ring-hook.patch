From 6c2f5c39d2486c41093677f473e061d7768ebbef Mon Sep 17 00:00:00 2001
From: INIM Fork <inim-dev@local>
Date: Wed, 25 Nov 2026 23:03:20 +0000
Subject: [PATCH] Block 2 (E-1 review round 8, items 1-4): key-ring preload
 hardening

1. Hook in I2CPDestination::Start (E-1 client side is an I2CP session):
   MaybeLoadTestKeyRing now runs for I2CP sessions too, not only
   ClientDestination. Multiple sessions load keyed entries per blinded
   ident; loads merge in each destination's own io_context thread.
2. Parser strictness: ANY broken peer_static_keys_b64 entry invalidates
   the WHOLE record (was a silent drop; a half-registered record would
   escape revocation by key-set). Unit test case 2b covers it.
3. One log line per load: path + registered/rejected counts, no key
   material; error line if the file cannot be opened (was silent).
4. ApplyTestKeyRingPreload takes a rejectedOut counter; logging moved to
   MaybeLoadTestKeyRing so exactly one summary line carries the path.

Build note: code under INIM_TEST_HOOKS now compiles both ways (CI steps
check the hook symbol is absent in regular builds and present with
-DINIM_TEST_HOOKS); Log.h include added for the hook build.
---
 libi2pd/TestKeyRingPreload.cpp | 41 +++++++++++++++++++++++++---------
 libi2pd/TestKeyRingPreload.h   | 12 ++++++----
 libi2pd_client/I2CP.cpp        | 13 +++++++++++
 libi2pd_client/I2CP.h          |  2 +-
 tests/test-keyring-preload.cpp | 27 +++++++++++++++++++++-
 5 files changed, 79 insertions(+), 16 deletions(-)

diff --git a/libi2pd/TestKeyRingPreload.cpp b/libi2pd/TestKeyRingPreload.cpp
index de4c053..1b85e15 100644
--- a/libi2pd/TestKeyRingPreload.cpp
+++ b/libi2pd/TestKeyRingPreload.cpp
@@ -1,6 +1,7 @@
 #include "TestKeyRingPreload.h"
 #include "Destination.h"
 #include "Config.h"
+#include "Log.h"
 #include <boost/property_tree/ptree.hpp>
 #include <boost/property_tree/json_parser.hpp>
 #include <sstream>
@@ -36,10 +37,13 @@ namespace client
 				for (const auto& pstr: *peers)
 				{
 					i2p::data::Tag<32> sk;
+					// Review round 8 item 3: one broken peer static key invalidates
+					// the WHOLE entry (a half-registered entry would survive a
+					// revocation by key-set). Never log key material.
 					if (Decode32 (pstr.second.get_value<std::string> (), sk))
 						entry.peerStaticKeys.push_back (sk);
-					// Invalid peer static key silently dropped (loading is test-only;
-					// parsing is strict and never logs key material).
+					else
+						entry.valid = false;
 				}
 			}
 			res.push_back (entry);
@@ -47,19 +51,20 @@ namespace client
 		return res;
 	}
 
-	size_t ApplyTestKeyRingPreload (LeaseSetDestination& dest, std::istream& s)
+	size_t ApplyTestKeyRingPreload (LeaseSetDestination& dest, std::istream& s, size_t* rejectedOut)
 	{
 		auto entries = ParseTestKeyRingPreload (s);
-		size_t registered = 0;
+		size_t registered = 0, rejected = 0;
 		for (auto& e: entries)
 		{
-			if (!e.valid) continue;
+			if (!e.valid) { ++rejected; continue; }
 			std::string key64 = e.key.ToBase64 ();
 			dest.SetKeyRingKey (e.blindedIdent, key64);
 			if (!e.peerStaticKeys.empty ())
 				dest.SetKeyRingSessionKeys (e.blindedIdent, e.peerStaticKeys);
 			++registered;
 		}
+		if (rejectedOut) *rejectedOut = rejected;
 		return registered;
 	}
 
@@ -68,17 +73,33 @@ namespace client
 	{
 		std::string path;
 		i2p::config::GetOption ("inim.test.keyring", path);
-		if (path.empty ()) return;
-		std::ifstream f (path);
-		if (!f) return;
+		if (path.empty ())
+		{
+			// One line even when disabled: an E-1 log must show the hook ran
+			// (review round 8 item 4).
+			LogPrint (eLogDebug, "TestKeyRingPreload: inim.test.keyring not set, nothing to load");
+			return;
+		}
 		// Post to the destination's io_context thread (m_Service): the key ring is
 		// not thread-safe and belongs to that thread (ADR-008, review round 5 item 1).
+		// Review round 8 item 1: called from ClientDestination::Start AND from
+		// RunnableI2CPDestination::Start; several sessions may load the same
+		// file concurrently, each loading keyed entries per blinded ident.
 		auto& svc = dest->GetService ();
 		auto destPtr = dest;
 		boost::asio::post (svc, [destPtr, path] () {
 			std::ifstream f (path);
-			if (!f) return;
-			ApplyTestKeyRingPreload (*destPtr, f);
+			if (!f)
+			{
+				LogPrint (eLogError, "TestKeyRingPreload: cannot open ", path);
+				return;
+			}
+			// Exactly one summary line: path, accepted and rejected counts,
+			// no key material (review round 8 item 4).
+			size_t rejected = 0;
+			auto registered = ApplyTestKeyRingPreload (*destPtr, f, &rejected);
+			LogPrint (eLogInfo, "TestKeyRingPreload: ", path, ": ", registered,
+				" entry(ies) registered, ", rejected, " rejected");
 		});
 	}
 #endif
diff --git a/libi2pd/TestKeyRingPreload.h b/libi2pd/TestKeyRingPreload.h
index 1e17220..5e9169c 100644
--- a/libi2pd/TestKeyRingPreload.h
+++ b/libi2pd/TestKeyRingPreload.h
@@ -12,9 +12,13 @@
 //       "peer_static_keys_b64": ["<32B base64>", ...] }
 //   ]
 //
-// Parsing is strict: base64 broken or wrong key length -> entry is dropped
-// (key not registered), no key material is logged -- identical semantics to
-// SetKeyRingKey's decode-failure path (review round 4 item 1).
+// Parsing is strict (review round 8 item 3): base64 broken or wrong key
+// length in ANY of blinded_ident_b64 / key_b64 / peer_static_keys_b64 ->
+// the WHOLE entry is invalid (valid=false) and never registered anywhere.
+// One bad peer static key must not silently lose the revoke link while the
+// key itself stays registered: revocation by key-set would then skip it.
+// No key material is logged -- identical semantics to SetKeyRingKey's
+// decode-failure path (review round 4 item 1).
 #include <string>
 #include <vector>
 #include <istream>
@@ -43,7 +47,7 @@ namespace client
 	// Apply a preload stream to a destination (must already run in the
 	// destination's io_context thread -- it mutates key-ring state). Invalid
 	// entries are skipped. Returns the number of entries registered.
-	size_t ApplyTestKeyRingPreload (LeaseSetDestination& dest, std::istream& s);
+	size_t ApplyTestKeyRingPreload (LeaseSetDestination& dest, std::istream& s, size_t* rejectedOut = nullptr);
 
 #ifdef INIM_TEST_HOOKS
 	// Startup hook: read the `inim.test.keyring=<path>` option, if present, and
