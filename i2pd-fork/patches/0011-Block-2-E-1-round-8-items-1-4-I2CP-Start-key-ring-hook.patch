+	void I2CPDestination::Start () // INIM E-1 review round 8 item 1
+	{
+		LeaseSetDestination::Start ();
+#ifdef INIM_TEST_HOOKS
+		// Test-only key-ring preload hook for E-1: the client side of E-1 is an
