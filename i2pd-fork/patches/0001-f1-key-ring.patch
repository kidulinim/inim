+const uint8_t * LeaseSetDestination::LookupKeyRing (const i2p::data::IdentHash& remoteDest)
+{
+std::lock_guard<std::mutex> lock (m_KeyRingMutex);
+auto it = m_KeyRing.find (remoteDest);
+if (it != m_KeyRing.end ())
+return (const uint8_t *)*(it->second);
+return m_LeaseSetPrivKey ? ((const uint8_t *)*m_LeaseSetPrivKey) : nullptr; // fallback: legacy session key
+}
+
+void LeaseSetDestination::SetKeyRingKey (const i2p::data::IdentHash& remoteDest, const std::string& keyBase64)
+{
+auto key = std::make_unique<i2p::data::Tag<32> >();
+if (key->FromBase64 (keyBase64) != 32)
+{
+LogPrint (eLogError, "Destination: Invalid key ring key for ", remoteDest.ToBase64 ());
+return;
+}
+std::lock_guard<std::mutex> lock (m_KeyRingMutex);
+m_KeyRing[remoteDest] = std::move (key);
+LogPrint (eLogInfo, "Destination: Key ring entry set for ", remoteDest.ToBase64 ());
+}
+
+void LeaseSetDestination::RemoveKeyRingKey (const i2p::data::IdentHash& remoteDest)
+{
+std::lock_guard<std::mutex> lock (m_KeyRingMutex);
+m_KeyRing.erase (remoteDest);
+LogPrint (eLogInfo, "Destination: Key ring entry removed for ", remoteDest.ToBase64 ());
+}
