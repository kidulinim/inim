+	void LeaseSetDestination::RemoveKeyRingKey (const i2p::data::IdentHash& blindedIdent)
 	{
-		i2p::data::Tag<32> key;
-		bool decodeOk = (key.FromBase64 (keyBase64) == 32);
-		std::fill (keyBase64.begin (), keyBase64.end (), '\0'); // scrub our copy even when decoding fails
-		if (!decodeOk)
+		i2p::data::IdentHash realIdent, storeHash;
+		bool hasCacheKeys = false;
+		std::vector<i2p::data::Tag<32> > sessionKeys;
 		{
-			LogPrint (eLogError, "Destination: Invalid key ring key for ", blindedIdent.ToBase64 ());
-			key.Fill (0);
-			return;
+			std::lock_guard<std::mutex> lock (m_KeyRingMutex);
+			auto it = m_KeyRing.find (blindedIdent);
+			if (it != m_KeyRing.end ())
+			{
+				it->second.Fill (0); // zeroize secret before erase
+				m_KeyRing.erase (it);
+			}
+			auto ck = m_KeyRingCacheKeys.find (blindedIdent);
+			if (ck != m_KeyRingCacheKeys.end ())
+			{
+				realIdent = ck->second.first;
+				storeHash = ck->second.second;
+				m_KeyRingCacheKeys.erase (ck);
+				hasCacheKeys = true;
+			}
+			auto sk = m_KeyRingSessionKeys.find (blindedIdent);
+			if (sk != m_KeyRingSessionKeys.end ())
+			{
+				sessionKeys = std::move (sk->second);
+				m_KeyRingSessionKeys.erase (sk);
+			}
 		}
-		std::lock_guard<std::mutex> lock (m_KeyRingMutex);
-		m_KeyRing[blindedIdent] = key;
-		key.Fill (0); // INIM fork F-1: don't leave the key copy on the stack
-		LogPrint (eLogInfo, "Destination: Key ring entry set for ", blindedIdent.ToBase64 ());
+		if (hasCacheKeys)
+		{
+			// INIM F-1 (spec v0.10 / Reviewer 1 round 3 item 5): the remote LeaseSet cache
+			// bypasses the key ring — evict the peer's entries under both its real ident and
+			// its (daily-rotating) store hash, so a revoked peer is no longer resolvable/sendable.
+			std::lock_guard<std::mutex> lock (m_RemoteLeaseSetsMutex);
+			m_RemoteLeaseSets.erase (realIdent);
+			m_RemoteLeaseSets.erase (storeHash);
+		}
+		for (const auto& sk : sessionKeys)
+		{
+			// INIM F-1 (spec v0.10 / Reviewer 1 round 3 item 5): terminate active routing sessions
+			// of this peer (ECIES-ratchet sessions, keyed by its static keys) — revocation must stop
+			// established sessions, not only new lookups (7.9).
+			RemoveECIESx25519Session (sk);
+		}
+		LogPrint (eLogInfo, "Destination: Key ring entry removed for ", blindedIdent.ToBase64 (),
+			hasCacheKeys ? " (LeaseSet cache evicted" : "",
+			sessionKeys.empty () ? ")" : " + sessions terminated)");
 	}
 
