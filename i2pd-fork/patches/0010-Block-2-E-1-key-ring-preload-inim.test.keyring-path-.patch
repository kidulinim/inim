diff --git a/tests/test-keyring-preload.cpp b/tests/test-keyring-preload.cpp
new file mode 100644
index 0000000..0760b58
--- /dev/null
+++ b/tests/test-keyring-preload.cpp
@@ -0,0 +1,97 @@
+// INIM fork: key-ring preload parser unit test (task-to-coder-ci-and-e1, block 2).
+// Covers ParseTestKeyRingPreload / ApplyTestKeyRingPreload: valid entry round-trip,
+// broken base64 and wrong key length -> entry dropped (valid=false, key never
+// registered), nothing about key material is printed, peer static keys decoded.
+#include <cassert>
+#include <cstring>
+#include <iostream>
+#include <sstream>
+#include <memory>
+
+#include "Destination.h"
+#include "TestKeyRingPreload.h"
+#include "Identity.h"
+
+class TestDestination: public i2p::client::ClientDestination
+{
+	public:
+		TestDestination (boost::asio::io_context& service, const i2p::data::PrivateKeys& keys):
+			ClientDestination (service, keys, false, nullptr) {}
+		~TestDestination () {}
+};
+
+static std::string b64_32 (uint8_t start)
+{
+	uint8_t raw[32];
+	for (int i = 0; i < 32; i++) raw[i] = (uint8_t)(start + i);
+	return i2p::data::ByteStreamToBase64 (raw, 32);
+}
+
+int main ()
+{
+	// 1) valid entry parsed and applied
+	std::string ident64 = b64_32 (1);
+	std::string key64 = b64_32 (33);
+	std::string peer64 = b64_32 (65);
+	std::stringstream doc;
+	doc << "[ { \"blinded_ident_b64\": \"" << ident64 << "\", "
+		<< "\"key_b64\": \"" << key64 << "\", "
+		<< "\"peer_static_keys_b64\": [ \"" << peer64 << "\" ] } ]";
+
+	auto entries = i2p::client::ParseTestKeyRingPreload (doc);
+	assert (entries.size () == 1);
+	assert (entries[0].valid);
+	assert (entries[0].peerStaticKeys.size () == 1);
+
+	boost::asio::io_context service;
+	auto keys = i2p::data::PrivateKeys::CreateRandomKeys (i2p::data::SIGNING_KEY_TYPE_EDDSA_SHA512_ED25519,
+		i2p::data::CRYPTO_KEY_TYPE_ECIES_X25519_AEAD);
+	auto dest = std::make_shared<TestDestination> (service, keys);
+
+	i2p::data::Tag<32> expectedIdent; expectedIdent.FromBase64 (ident64);
+	i2p::data::Tag<32> expectedKey; expectedKey.FromBase64 (key64);
+	std::stringstream doc2;  // fresh: "doc" was consumed by the parse pass above
+	doc2 << doc.str ();
+	assert (i2p::client::ApplyTestKeyRingPreload (*dest, doc2) == 1);
+	i2p::data::Tag<32> got;
+	assert (dest->GetKeyRingKey (expectedIdent, got));
+	assert (!memcmp (got, expectedKey, 32));
+
+	// 2) broken base64 key -> entry invalid, key not registered
+	{
+		std::stringstream bad;
+		bad << "[ { \"blinded_ident_b64\": \"" << ident64 << "\", "
+			<< "\"key_b64\": \"!!!broken-base64!!!\", "
+			<< "\"peer_static_keys_b64\": [ \"" << peer64 << "\" ] } ]";
+		auto badEntries = i2p::client::ParseTestKeyRingPreload (bad);
+		assert (badEntries.size () == 1);
+		assert (!badEntries[0].valid);
+	}
+	// 3) wrong key length -> entry invalid
+	{
+		std::stringstream shortk;
+		shortk << "[ { \"blinded_ident_b64\": \"" << ident64 << "\", "
+			<< "\"key_b64\": \"" << i2p::data::ByteStreamToBase64 ((const uint8_t *)"short", 5) << "\" } ]";
+		auto shortEntries = i2p::client::ParseTestKeyRingPreload (shortk);
+		assert (shortEntries.size () == 1);
+		assert (!shortEntries[0].valid);
+	}
+	// 4) broken base64 for blinded_ident -> invalid too
+	{
+		std::stringstream badId;
+		badId << "[ { \"blinded_ident_b64\": \"!!bad!!\", "
+			<< "\"key_b64\": \"" << key64 << "\" } ]";
+		auto badIdEntries = i2p::client::ParseTestKeyRingPreload (badId);
+		assert (badIdEntries.size () == 1);
+		assert (!badIdEntries[0].valid);
+	}
+	// 5) whole file malformed JSON -> empty parse, no crash
+	{
+		std::stringstream notJson;
+		notJson << "this is not json {{{";
+		assert (i2p::client::ParseTestKeyRingPreload (notJson).empty ());
+	}
+
+	std::cout << "test-keyring-preload: all checks passed" << std::endl;
+	return 0;
+}
