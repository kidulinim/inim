diff --git a/libi2pd/TestKeyRingPreload.h b/libi2pd/TestKeyRingPreload.h
new file mode 100644
index 0000000..1e17220
--- /dev/null
+++ b/libi2pd/TestKeyRingPreload.h
@@ -0,0 +1,57 @@
+#ifndef TEST_KEY_RING_PRELOAD_H_
+#define TEST_KEY_RING_PRELOAD_H_
+
+// INIM fork test-only artifacts (task-to-coder-ci-and-e1, block 2): a startup
+// key-ring preload for experiment E-1, gated behind the INIM_TEST_HOOKS
+// preprocessor macro so it does not exist in release builds.
+//
+// File format (JSON list):
+//   [
+//     { "blinded_ident_b64": "<32B base64>",
+//       "key_b64": "<32B base64>",
+//       "peer_static_keys_b64": ["<32B base64>", ...] }
+//   ]
+//
+// Parsing is strict: base64 broken or wrong key length -> entry is dropped
+// (key not registered), no key material is logged -- identical semantics to
+// SetKeyRingKey's decode-failure path (review round 4 item 1).
+#include <string>
+#include <vector>
+#include <istream>
+#include <memory>
+#include "Identity.h"
+
+namespace i2p
+{
+namespace client
+{
+	class LeaseSetDestination;
+
+	struct TestKeyRingEntry
+	{
+		i2p::data::IdentHash blindedIdent;
+		i2p::data::Tag<32> key;
+		std::vector<i2p::data::Tag<32> > peerStaticKeys; // link tag-set owners for revoke
+		bool valid = false;
+	};
+
+	// Pure parser (always compiled, so unit tests can exercise it): read a
+	// key-ring preload document. Entries that fail base64 or key length decode
+	// are returned with valid=false and never registered anywhere.
+	std::vector<TestKeyRingEntry> ParseTestKeyRingPreload (std::istream& s);
+
+	// Apply a preload stream to a destination (must already run in the
+	// destination's io_context thread -- it mutates key-ring state). Invalid
+	// entries are skipped. Returns the number of entries registered.
+	size_t ApplyTestKeyRingPreload (LeaseSetDestination& dest, std::istream& s);
+
+#ifdef INIM_TEST_HOOKS
+	// Startup hook: read the `inim.test.keyring=<path>` option, if present, and
+	// post ApplyTestKeyRingPreload into the destination's thread.
+	void MaybeLoadTestKeyRing (std::shared_ptr<LeaseSetDestination> dest);
+#endif
+
+}
+}
+
+#endif
