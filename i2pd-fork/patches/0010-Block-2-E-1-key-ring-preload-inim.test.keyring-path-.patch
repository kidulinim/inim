diff --git a/libi2pd/TestKeyRingPreload.cpp b/libi2pd/TestKeyRingPreload.cpp
new file mode 100644
index 0000000..de4c053
--- /dev/null
+++ b/libi2pd/TestKeyRingPreload.cpp
@@ -0,0 +1,87 @@
+#include "TestKeyRingPreload.h"
+#include "Destination.h"
+#include "Config.h"
+#include <boost/property_tree/ptree.hpp>
+#include <boost/property_tree/json_parser.hpp>
+#include <sstream>
+#include <fstream>
+#include <iostream>
+
+namespace i2p
+{
+namespace client
+{
+	static bool Decode32 (const std::string& b64, i2p::data::Tag<32>& out)
+	{
+		return out.FromBase64 (b64) == 32;
+	}
+
+	std::vector<TestKeyRingEntry> ParseTestKeyRingPreload (std::istream& s)
+	{
+		std::vector<TestKeyRingEntry> res;
+		boost::property_tree::ptree pt;
+		try { boost::property_tree::read_json (s, pt); }
+		catch (const std::exception& e) { (void)e; return res; }
+
+		for (const auto& item: pt)
+		{
+			const auto& row = item.second;
+			TestKeyRingEntry entry;
+			bool bp = Decode32 (row.get<std::string> ("blinded_ident_b64", ""), entry.blindedIdent);
+			bool kp = Decode32 (row.get<std::string> ("key_b64", ""), entry.key);
+			entry.valid = bp && kp;
+			auto peers = row.get_child_optional ("peer_static_keys_b64");
+			if (peers)
+			{
+				for (const auto& pstr: *peers)
+				{
+					i2p::data::Tag<32> sk;
+					if (Decode32 (pstr.second.get_value<std::string> (), sk))
+						entry.peerStaticKeys.push_back (sk);
+					// Invalid peer static key silently dropped (loading is test-only;
+					// parsing is strict and never logs key material).
+				}
+			}
+			res.push_back (entry);
+		}
+		return res;
+	}
+
+	size_t ApplyTestKeyRingPreload (LeaseSetDestination& dest, std::istream& s)
+	{
+		auto entries = ParseTestKeyRingPreload (s);
+		size_t registered = 0;
+		for (auto& e: entries)
+		{
+			if (!e.valid) continue;
+			std::string key64 = e.key.ToBase64 ();
+			dest.SetKeyRingKey (e.blindedIdent, key64);
+			if (!e.peerStaticKeys.empty ())
+				dest.SetKeyRingSessionKeys (e.blindedIdent, e.peerStaticKeys);
+			++registered;
+		}
+		return registered;
+	}
+
+#ifdef INIM_TEST_HOOKS
+	void MaybeLoadTestKeyRing (std::shared_ptr<LeaseSetDestination> dest)
+	{
+		std::string path;
+		i2p::config::GetOption ("inim.test.keyring", path);
+		if (path.empty ()) return;
+		std::ifstream f (path);
+		if (!f) return;
+		// Post to the destination's io_context thread (m_Service): the key ring is
+		// not thread-safe and belongs to that thread (ADR-008, review round 5 item 1).
+		auto& svc = dest->GetService ();
+		auto destPtr = dest;
+		boost::asio::post (svc, [destPtr, path] () {
+			std::ifstream f (path);
+			if (!f) return;
+			ApplyTestKeyRingPreload (*destPtr, f);
+		});
+	}
+#endif
+
+}
+}
\ No newline at end of file
diff --git a/libi2pd/TestKeyRingPreload.h b/libi2pd/TestKeyRingPreload.h
new file mode 100644
index 0000000..1e17220
--- /dev/null
+++ b/libi2pd/TestKeyRingPreload.h
@@ -0,0 +1,57 @@
+#ifndef TEST_KEY_RING_PRELOAD_H_
+#define TEST_KEY_RING_PRELOAD_H_
+
+// INIM fork test-only artifacts (task-to-coder-ci-and-e1, block 2): a startup
+// key-ring preload for experiment E-1, gated behind the INIM_TEST_HOOKS
+// preprocessor macro so it does not exist in release builds.
+//
+// File format (JSON list):
+//   [
+//     { "blinded_ident_b64": "<32B base64>",
+//       "key_b64": "<32B base64>",
+//       "peer_static_keys_b64": ["<32B base64>", ...] }
+//   ]
+//
+// Parsing is strict: base64 broken or wrong key length -> entry is dropped
+// (key not registered), no key material is logged -- identical semantics to
+// SetKeyRingKey's decode-failure path (review round 4 item 1).
+#include <string>
+#include <vector>
+#include <istream>
+#include <memory>
+#include "Identity.h"
+
+namespace i2p
+{
+namespace client
+{
+	class LeaseSetDestination;
+
+	struct TestKeyRingEntry
+	{
+		i2p::data::IdentHash blindedIdent;
+		i2p::data::Tag<32> key;
+		std::vector<i2p::data::Tag<32> > peerStaticKeys; // link tag-set owners for revoke
+		bool valid = false;
+	};
+
+	// Pure parser (always compiled, so unit tests can exercise it): read a
+	// key-ring preload document. Entries that fail base64 or key length decode
+	// are returned with valid=false and never registered anywhere.
+	std::vector<TestKeyRingEntry> ParseTestKeyRingPreload (std::istream& s);
+
+	// Apply a preload stream to a destination (must already run in the
+	// destination's io_context thread -- it mutates key-ring state). Invalid
+	// entries are skipped. Returns the number of entries registered.
+	size_t ApplyTestKeyRingPreload (LeaseSetDestination& dest, std::istream& s);
+
+#ifdef INIM_TEST_HOOKS
+	// Startup hook: read the `inim.test.keyring=<path>` option, if present, and
+	// post ApplyTestKeyRingPreload into the destination's thread.
+	void MaybeLoadTestKeyRing (std::shared_ptr<LeaseSetDestination> dest);
+#endif
+
+}
+}
+
+#endif
