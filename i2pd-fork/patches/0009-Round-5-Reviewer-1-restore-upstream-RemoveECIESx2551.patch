@@ -230,6 +230,16 @@ namespace client
 			int m_LeaseSetType, m_AuthType;
 			std::unique_ptr<i2p::data::Tag<32> > m_LeaseSetPrivKey; // non-null if presented
 			mutable std::mutex m_KeyRingMutex;
+			// INIM F-1 thread safety rule (Reviewer 1 round 5 item 1): m_RemoteLeaseSets and
+			// m_KeyRingCacheKeys are guarded by their own mutexes; m_ECIESx25519Sessions and
+			// m_ECIESx25519Tags (GarlicDestination) have NO mutex and belong to the
+			// destination io_context thread. All revoke-path operations (SetKeyRingKey,
