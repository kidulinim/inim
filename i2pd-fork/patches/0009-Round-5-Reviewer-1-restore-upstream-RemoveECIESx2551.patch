+	void LeaseSetDestination::InsertRemoteLeaseSetForTest (const i2p::data::IdentHash& blindedIdent,
+		const i2p::data::IdentHash& storeHash, std::shared_ptr<i2p::data::LeaseSet> ls)
+	{
+		// INIM test-only hook (round 5 item 3): replicate the cache bookkeeping of a
+		// successful HandleDatabaseStoreMessage store, nothing else.
+		{
+			std::lock_guard<std::mutex> lock (m_RemoteLeaseSetsMutex);
+			m_RemoteLeaseSets[ls->GetIdentHash ()] = ls; // real ident
+			m_RemoteLeaseSets[storeHash] = ls; // daily store hash
+		}
+		std::lock_guard<std::mutex> lock (m_KeyRingMutex);
+		m_KeyRingCacheKeys[blindedIdent] = {ls->GetIdentHash (), storeHash};
+	}
 
