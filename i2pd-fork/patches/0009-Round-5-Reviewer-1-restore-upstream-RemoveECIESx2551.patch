 			std::map<i2p::data::IdentHash, std::vector<i2p::data::Tag<32> > > m_KeyRingSessionKeys; // blindedIdent -> peer ECIES static keys, to terminate sessions on revoke
@@ -243,6 +253,13 @@ namespace client
 			bool GetKeyRingKey (const i2p::data::IdentHash& blindedIdent, i2p::data::Tag<32> & k) const; // INIM fork F-1/F-11
