diff --git a/tests/test-keyring-revocation.cpp b/tests/test-keyring-revocation.cpp
index 9a3d45f..385602e 100644
--- a/tests/test-keyring-revocation.cpp
+++ b/tests/test-keyring-revocation.cpp
@@ -12,6 +12,15 @@
 #include "Destination.h"
 #include "ECIESX25519AEADRatchetSession.h"
 #include "Identity.h"
+#include "LeaseSet.h"
+
+// Minimal LeaseSet with only an identity — enough for cache-eviction checks
+// (GetIdentHash comes from m_Identity).
+class TestLeaseSet: public i2p::data::LeaseSet
+{
+	public:
+		TestLeaseSet (std::shared_ptr<const i2p::data::IdentityEx> ident): LeaseSet (true) { SetIdentity (std::move (ident)); }
+};
 
 // Minimal ClientDestination for key-ring unit checks (not Start()ed: F-1's
 // SetKeyRingKey/GetKeyRingKey don't depend on tunnels or netdb).
@@ -60,6 +69,27 @@ int main ()
 	assert (dest->GetNumIncomingECIESx25519Tags () == 0);           // session tags dropped
 	assert (session->IsTerminated ());                              // session terminated
 
+	// 3) cache eviction: a LeaseSet cached under both real ident and daily store
+	//    hash is evicted by RemoveKeyRingKey (round 4 item 5 / round 5 item 3).
+	{
+		auto peerKeys = i2p::data::PrivateKeys::CreateRandomKeys (i2p::data::SIGNING_KEY_TYPE_EDDSA_SHA512_ED25519,
+			i2p::data::CRYPTO_KEY_TYPE_ECIES_X25519_AEAD);
+		auto ls = std::make_shared<TestLeaseSet> (peerKeys.GetPublic ());
+		i2p::data::IdentHash realIdent = ls->GetIdentHash ();
+		i2p::data::IdentHash storeHash; storeHash.Randomize (); // daily store hash, differs from ident
+
+		dest->SetKeyRingKey (blinded, key64);
+		dest->InsertRemoteLeaseSetForTest (blinded, storeHash, ls);
+		assert (dest->GetNumRemoteLeaseSets () == 2);
+		assert (dest->GetLeaseSets ().count (realIdent) == 1);
+		assert (dest->GetLeaseSets ().count (storeHash) == 1);
+
+		dest->RemoveKeyRingKey (blinded);
+		assert (dest->GetNumRemoteLeaseSets () == 0);               // both cache entries evicted
+		assert (dest->GetLeaseSets ().count (realIdent) == 0);
+		assert (dest->GetLeaseSets ().count (storeHash) == 0);
+	}
+
 	std::cout << "test-keyring-revocation: all checks passed" << std::endl;
 	return 0;
 }
